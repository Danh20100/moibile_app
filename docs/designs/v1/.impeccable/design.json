  "narrative": {
    "northStar": "The Room Ledger",
    "overview": "A living operational record for each rented room. Warm paper, bottle green and clay event marks connect discovery, daily rental obligations and work by room. The numbered apartment door plate and dated records form the reusable identity; amounts and provenance remain readable without a card around every item.\n\nThis authority captures the completed HTML visual rewrite. The old stylesheet and screen helpers were replaced by one new family. It documents an Android-oriented artifact, not an implemented Compose redesign. PRODUCT.md and canonical v3.7 constrain domain presentation; current OpenAPI constrains exposed transport.",
    "keyCharacteristics": [
      "Apartment-door identity and dated source records.",
      "One component family, three distinct POV hierarchies.",
      "Flat paper surfaces, dividers and tabular money.",
      "Labeled media placeholders and explicit policy boundaries."
    ],
    "rules": [
      {
        "name": "The State Label Rule",
        "body": "A color mark always accompanies meaningful state text; color alone never confirms business truth.",
        "section": "colors"
      },
      {
        "name": "The Amount Rule",
        "body": "A large amount must retain its period, due state or confirmation context. Typography cannot collapse owed money and received money into the same fact.",
        "section": "typography"
      },
      {
        "name": "The Source Record Rule",
        "body": "Dashboard, History and Notification project source records; they never become the owner of a business mutation.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve stable inventory IDs and metadata; scope classifications change only with explicit approval.",
      "Do identify the room, current context and source before presenting the next allowed action.",
      "Do use labeled states alongside color, persistent field labels and visible focus.",
      "Do keep Charge, Payment, Claim, Deposit and Receipt visually and semantically distinct.",
      "Do validate the artifact in both themes and report native device work separately."
    ],
    "donts": [
      "Don't turn every record or metric into an identical card.",
      "Don't treat a submitted Claim or provider handoff as confirmed Payment.",
      "Don't expose exact operational addresses through public discovery.",
      "Don't move FUTURE surfaces into current app navigation or activate unresolved OPEN controls.",
      "Don't present authored SVG placeholders or sample records as factual property evidence."
    ]
  }
}
