# Application
# Used when running the backend directly on the host (non-Docker).
PORT=3000

# Docker host ports
BACKEND_PORT=3000
POSTGRES_PORT=5432

# Google Identity
GOOGLE_CLIENT_ID=

# PostgreSQL persistence
POSTGRES_USER=trooi
POSTGRES_PASSWORD=trooi_local
POSTGRES_DB=trooi_dev
POSTGRES_TEST_DB=trooi_test

# Host-side database URLs (for local scripts/tests outside Docker)
DATABASE_URL=postgresql://trooi:trooi_local@localhost:5432/trooi_dev
TEST_DATABASE_URL=postgresql://trooi:trooi_local@localhost:5432/trooi_test
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional MoMo channel. Empty credentials keep startup/manual payments available.
# captureWallet autoCapture=true; only verified IPN confirms money. HTTP timeout: 35s.
# Strict create-response signature required; sandbox acceptance remains a live verification gate.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
# Production endpoint/allowed payUrl host: https://payment.momo.vn
# IPN must be public HTTPS; register the redirect URI in the mobile app.
MOMO_IPN_URL=
MOMO_REDIRECT_URL=trooi://payment/momo

# Optional cache foundation (not yet wired into the NestJS runtime).
# When a Redis adapter is implemented, use e.g. redis://redis:6379 inside Docker.
REDIS_URL=
CACHE_ENVIRONMENT=
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_DEV_PORT=6379

# Optional private object storage foundation (not yet wired into upload routes).
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=trooi-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Development-only MinIO instance; supply a strong password in untracked .env.
MINIO_ROOT_USER=trooi_local
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# SePay. Sandbox config never enables production. Production requires SEPAY_ENVIRONMENT=production,
# a dedicated finance database name in both DATABASE_URL and SEPAY_FINANCE_DATABASE, and a public HTTPS origin.
# IPN URL is {SEPAY_PUBLIC_BASE_URL}/api/v1/finance/checkouts/sepay/ipn with auth type SECRET_KEY.
# SEPAY_IPN_SECRET_KEY must differ from SEPAY_SECRET_KEY and SEPAY_HANDOFF_SIGNING_KEY.
# Do not put live secrets in this file.
SEPAY_ENABLED=
SEPAY_ENVIRONMENT=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
SEPAY_PUBLIC_BASE_URL=
SEPAY_HANDOFF_SIGNING_KEY=
SEPAY_FINANCE_DATABASE=
TROOI_PAYMENT_PUBLIC_ORIGIN=

# Local simulated DemoPay only; always unavailable in production.
DEMO_PAYMENT_ENABLED=false
DEMO_PAYMENT_PUBLIC_BASE_URL=
DEMO_PAYMENT_SIGNING_KEY=
