# TroOi - minimal environment for a single PostgreSQL database and Google auth.
# Copy to .env. Keep real passwords and provider values PRIVATE (never commit .env).

# Docker Compose backend (3101 avoids another app using host port 3000).
BACKEND_PORT=3101

# Required by Compose. TEST_DB matches the main DB to avoid creating a second one.
# Destructive integration and E2E reset tests MUST NOT target tro-oi.
POSTGRES_USER=trooi
POSTGRES_PASSWORD=
POSTGRES_DB=tro-oi
POSTGRES_TEST_DB=tro-oi

# The DEFAULT Compose stack also starts MinIO, Redis and all five CompreFace services.
# Set unique private credentials before first up; never commit or use demo secrets.
MINIO_ROOT_USER=trooi_local
MINIO_ROOT_PASSWORD=
TROOI_COMPREFACE_DB_PASSWORD=
# Enabling KYC additionally needs a CompreFace Verification Service API key.
# A newly initialized CompreFace DB needs service/key provisioning once.
COMPREFACE_ENABLED=false
COMPREFACE_ORIGIN=http://compreface-fe
COMPREFACE_API_KEY=
TROOI_LOCAL_COMPREFACE_LAB=true

# Same Google Web OAuth Client ID is used by the backend and Android.
# Android's TROOI_GOOGLE_WEB_CLIENT_ID falls back to GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Email registration and recovery OTP (enabled when SMTP and HMAC settings are complete)
TROOI_OTP_HMAC_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Identity session cutover: keep false until the approved preflight is complete.
# Google authentication will NOT work end-to-end while this is false.
TROOI_IDENTITY_FOUNDATION_RESOLUTION_ENABLED=false

# Android Release needs a REAL, reachable HTTPS backend URL.
# For emulator Debug instead, override the build with:
# -PtrooiApiBaseUrl=http://10.0.2.2:3101
TROOI_API_BASE_URL=

# Maps: MapLibre works without a Google Maps API key.
TROOI_MAP_PROVIDER=maplibre
TROOI_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
TROOI_MAPS_API_KEY=

# Payment return origins: a signed Release requires valid HTTPS destinations when payments are enabled.
TROOI_PAYMENT_PUBLIC_ORIGIN=
TROOI_RELEASE_PAYMENT_PUBLIC_ORIGIN=

# SePay provider settings. Disabled until the production finance checks pass.
# Never commit the actual provider credentials to this file.
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
SEPAY_PUBLIC_BASE_URL=
SEPAY_HANDOFF_SIGNING_KEY=
SEPAY_FINANCE_DATABASE=
SEPAY_FINANCE_DATABASE_URL=
# Finance profile host port must not collide with the main backend port 3101.
SEPAY_BACKEND_PORT=3102

# Optional MoMo payments; do not configure credentials unless enabling MoMo.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_IPN_URL=
MOMO_REDIRECT_URL=trooi://payment/momo

# Signing keys belong in ignored keystore.properties, NOT in .env.
# Local Docker binds to 127.0.0.1 by default. Reverse-proxy HTTPS separately.
# Other optional Redis, media storage, CompreFace, demo, and test profiles:
# docs/configuration/optional-environment.md
