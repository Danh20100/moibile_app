# TrọƠi - single template for local, Docker and Android client configuration.
# Copy to .env and fill private values. NEVER commit .env or paste its contents.
# The example deliberately leaves passwords, signing keys and provider credentials empty.

# Host-side NestJS runtime. Docker always sets NODE_ENV=production and listens on 0.0.0.0.
NODE_ENV=development
PORT=3000
TROOI_BIND_HOST=127.0.0.1
# Managed by the Docker entrypoint. Empty on host; Compose sets an explicit mode.
TROOI_DATABASE_MODE=

# Compose image and local host ports (localhost-bound by default).
BACKEND_PORT=3000
TROOI_BACKEND_IMAGE=trooi-backend:local
POSTGRES_PORT=5432
SEPAY_BACKEND_PORT=3101

# PostgreSQL main DEV database; replace POSTGRES_PASSWORD before first Compose startup.
POSTGRES_USER=trooi
POSTGRES_PASSWORD=
POSTGRES_DB=trooi_dev
POSTGRES_TEST_DB=trooi_test

# Only for scripts / tests run on the Windows host. Set an URL-encoded password in URLs.
# Docker builds the default backend URL safely from POSTGRES_* itself.
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Google identity. Web OAuth ID is not secret; no Google client secret belongs in Android.
GOOGLE_CLIENT_ID=
TROOI_IDENTITY_FOUNDATION_RESOLUTION_ENABLED=false
TROOI_DEMO_CLAIM_USER_ID=

# Identity migration preflight is a READ-ONLY standalone script; never points at finance DB.
IDENTITY_PREFLIGHT_DATABASE_URL=
TROOI_IDENTITY_PREFLIGHT_READ_ONLY=1

# Optional MoMo channel. Provider credentials remain server-only.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_IPN_URL=
MOMO_REDIRECT_URL=trooi://payment/momo

# Optional Redis integration: inside Compose use redis://redis:6379; for host use localhost.
REDIS_URL=
CACHE_ENVIRONMENT=
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_DEV_PORT=6379

# Optional private S3/MinIO storage. Inside Compose use http://minio:9000.
# Set OBJECT_STORAGE_ACCESS_KEY/SECRET_KEY to provisioned MinIO credentials if enabled.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=trooi-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=trooi_local
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional CompreFace evidence integration. Never embed API key in APK.
COMPREFACE_ENABLED=false
COMPREFACE_ORIGIN=
COMPREFACE_API_KEY=
COMPREFACE_TIMEOUT_MS=15000

# Production SePay must run only on the dedicated finance-backend Compose profile.
# Finance DB needs the FULL TrọƠi schema and authorized users/tenancies.
# SEPAY_FINANCE_DATABASE_URL must be reachable FROM the finance-backend container.
# SEPAY_FINANCE_DATABASE must exactly equal the URL database name (not trooi_dev/test).
# Provider IPN public HTTPS origin needs a route-limited reverse proxy, not public /demo.
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
SEPAY_PUBLIC_BASE_URL=
SEPAY_HANDOFF_SIGNING_KEY=
SEPAY_FINANCE_DATABASE=
SEPAY_FINANCE_DATABASE_URL=

# Optional DemoPay adapter is never enabled inside Docker.
DEMO_PAYMENT_ENABLED=false
DEMO_PAYMENT_PUBLIC_BASE_URL=
DEMO_PAYMENT_SIGNING_KEY=

# Loopback-only demonstration runner, forbidden in production and not part of Compose.
# Never point these scripts at an actual bank settlement database outside the isolated test.
TROOI_DEMO_MVP_ENABLED=false
TROOI_DEMO_MVP_PORT=3001
TROOI_DEMO_PASSWORD=
TROOI_SEPAY_PAYMENT_FIXTURE=false
TROOI_SEPAY_TEST_AMOUNT=1000

# Host bind for Compose backend publish (default 127.0.0.1). Use 0.0.0.0 for phone-on-LAN debug.
TROOI_BACKEND_BIND=127.0.0.1

# Android client ALLOWLIST; only these client-safe values go to BuildConfig.
# Debug emulator connects to host via 10.0.2.2; a phone requires LAN/HTTPS instead.
TROOI_API_BASE_URL=http://10.0.2.2:3000
TROOI_GOOGLE_WEB_CLIENT_ID=
TROOI_MAPS_API_KEY=
# Free map default: no Google Billing or OpenFreeMap API key.
TROOI_MAP_PROVIDER=maplibre
TROOI_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
TROOI_PAYMENT_PUBLIC_ORIGIN=
TROOI_RELEASE_PAYMENT_PUBLIC_ORIGIN=
TROOI_DEMO_BACKEND_ENABLED=false

# Optional isolated messaging test profile.
MESSAGING_DB_NAME=messaging_test
MESSAGING_DB_USER=messaging_test
MESSAGING_DB_PASSWORD=
MESSAGING_DB_PORT=55447
MESSAGING_MINIO_USER=messaging-local
MESSAGING_MINIO_PASSWORD=
MESSAGING_MINIO_PORT=9047
MESSAGING_MINIO_CONSOLE_PORT=9048

# Optional isolated SePay TEST DB; never point to historical real-money volumes.
TROOI_STANDALONE_DB_PASSWORD=
SEPAY_ISOLATED_DB_PORT=55459
