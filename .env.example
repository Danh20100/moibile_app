# Application
# Used when running the backend directly on the host (non-Docker).
PORT=3000

# Docker host ports
BACKEND_PORT=3000
WEB_PORT=4173
POSTGRES_PORT=5432

# Google Identity
GOOGLE_CLIENT_ID=

# PostgreSQL persistence
POSTGRES_USER=trooi
POSTGRES_PASSWORD=trooi_local
POSTGRES_DB=trooi_dev
POSTGRES_TEST_DB=trooi_test

# Host-side database URLs (for local scripts/tests outside Docker)
DATABASE_URL=postgresql://trooi:trooi_local@localhost:5432/trooi_dev
TEST_DATABASE_URL=postgresql://trooi:trooi_local@localhost:5432/trooi_test
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Optional MoMo channel. Empty credentials keep startup/manual payments available.
# captureWallet autoCapture=true; only verified IPN confirms money. HTTP timeout: 35s.
# Strict create-response signature required; sandbox acceptance remains a live verification gate.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
# Production endpoint/allowed payUrl host: https://payment.momo.vn
# IPN must be public HTTPS; register the redirect URI in the mobile app.
MOMO_IPN_URL=
MOMO_REDIRECT_URL=trooi://payment/momo

# SePay Sandbox structural placeholders only; channel remains unavailable.
# IPN credential relationship is unverified; no secret fallback or provider certification.
SEPAY_ENABLED=
SEPAY_ENVIRONMENT=
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
SEPAY_PUBLIC_BASE_URL=
SEPAY_HANDOFF_SIGNING_KEY=
TROOI_PAYMENT_PUBLIC_ORIGIN=
