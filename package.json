{
  "name": "trooi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TrọƠi backend application",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 9229 --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"*.{json,mjs}\" \".vscode/*.json\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.ts\" \"*.{json,mjs}\" \".vscode/*.json\"",
    "test": "nest build && tsx --test src/**/*.spec.ts tests/**/*.test.ts",
    "test:conformance:erd3": "tsx --test tests/conformance/erd3/*.test.ts",
    "test:core-foundation": "tsx --test tests/core/organization.behavior.test.ts tests/core/property.behavior.test.ts tests/core/room.behavior.test.ts tests/conformance/erd3/identity.contract.test.ts tests/conformance/erd3/organization.contract.test.ts tests/conformance/erd3/property-room.lifecycle.test.ts tests/conformance/erd3/future-open-boundary.static.test.ts",
    "test:domain-contract:junit": "node --import tsx --test --test-reporter=junit --test-reporter-destination=domain-contract.junit.xml \"tests/conformance/erd3/*.test.ts\"",
    "test:full:junit": "nest build && node --import tsx --test --test-reporter=junit --test-reporter-destination=full-test.junit.xml \"src/**/*.spec.ts\" \"tests/**/*.test.ts\"",
    "verify:test-baseline": "node scripts/verify-test-baseline.mjs",
    "test:google:live": "node --env-file=.env --import tsx tests/live/google-identity/google-id-token.live.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
