{
  "name": "trooi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TrọƠi backend application",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 9229 --watch",
    "db:dev:up": "docker compose -f compose.persistence.yml up -d",
    "db:dev:down": "docker compose -f compose.persistence.yml down",
    "db:dev:logs": "docker compose -f compose.persistence.yml logs -f postgres",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "db:migrate": "tsx scripts/database/migrate.ts up",
    "db:migrate:down": "tsx scripts/database/migrate.ts down",
    "db:reset": "pnpm db:migrate:down && pnpm db:migrate:down && pnpm db:migrate",
    "db:seed": "tsx database/seeds/development.ts",
    "e2e:seed": "node --env-file=.env --import tsx tests/e2e/seed/seed.ts",
    "e2e:reset": "node --env-file=.env --import tsx tests/e2e/seed/reset.ts",
    "e2e:flow": "node --env-file=.env --import tsx tests/e2e/run-flow.ts",
    "e2e:coverage": "node --import tsx tests/e2e/validate-v1-coverage.ts",
    "test:persistence:migration": "tsx --test tests/integration/persistence/migration-parity.integration.ts",
    "build": "nest build",
    "openapi:generate": "nest build && node scripts/openapi/generate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.ts\" \"*.{json,mjs}\" \".vscode/*.json\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.ts\" \"*.{json,mjs}\" \".vscode/*.json\"",
    "test": "nest build && tsx --test src/**/*.spec.ts tests/**/*.test.ts",
    "test:conformance:database-v1": "tsx --test tests/conformance/database-v1/*.test.ts",
    "test:ledger:lifecycle-restart": "tsx --test tests/integration/persistence/application-wiring.integration.ts",
    "test:ledger:media-faults": "tsx --test tests/integration/listing-asset-media.persistence.integration.ts",
    "test:messaging:integration": "tsx --test tests/integration/messaging.integration.ts",
    "test:core-foundation": "tsx --test tests/core/organization.behavior.test.ts tests/core/property.behavior.test.ts tests/core/room.behavior.test.ts tests/conformance/database-v1/identity.contract.test.ts tests/conformance/database-v1/organization.contract.test.ts tests/conformance/database-v1/property-room.lifecycle.test.ts tests/conformance/database-v1/future-open-boundary.static.test.ts tests/core/dto-boundary.validation.test.ts",
    "test:domain-contract:junit": "node --import tsx --test --test-reporter=junit --test-reporter-destination=domain-contract.junit.xml \"tests/conformance/database-v1/*.test.ts\"",
    "test:full:junit": "nest build && node --import tsx --test --test-reporter=junit --test-reporter-destination=full-test.junit.xml \"src/**/*.spec.ts\" \"tests/**/*.test.ts\"",
    "verify:test-baseline": "node scripts/verify-test-baseline.mjs",
    "test:google:live": "node --env-file=.env --import tsx tests/live/google-identity/google-id-token.live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5.2.1",
    "google-auth-library": "^11.1.0",
    "jpeg-js": "0.4.4",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
